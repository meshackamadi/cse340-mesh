<%- include('partials/header') %>

<main>
    <% if (project) { %>
        <h1><%= title %></h1>
        <h2><%= project.title || project.project_title %></h2>
        <p><strong>Description:</strong> <%= project.description || 'No description available.' %></p>
        <p><strong>Date:</strong> <%= project.date || project.project_date %></p>
        <p><strong>Location:</strong> <%= project.location || 'Location to be announced.' %></p>
        <p>
            <strong>Organization:</strong>
            <a href="/organization/<%= project.organization_id %>">
                <%= project.organization_name %>
            </a>
        </p>
        <p>
            <strong>Categories:</strong>
            <% if (categories.length > 0) { %>
                <% categories.forEach((category, index) => { %>
                    <a class="category-tag" href="/category/<%= category.category_id %>">
                        <%= category.name %>
                    </a><%= index < categories.length - 1 ? ' ' : '' %>
                <% }); %>
            <% } else { %>
                <span>No categories assigned.</span>
            <% } %>
        </p>
    <% } else { %>
        <h1>Service Project Not Found</h1>
        <p>The service project you are looking for does not exist.</p>
        <p><a href="/projects">Return to service projects</a></p>
    <% } %>
</main>

<%- include('partials/footer') %>
